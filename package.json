{
  "name": "mma",
  "version": "1.0.0",
  "private": true,
  "description": "MMA, Monsieur Pierre's mov-cli: a web GUI for movies and series on GitHub Pages, with a Cloudflare Worker finding the streams.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node tools/build-worker.mjs",
    "check": "node tools/build-worker.mjs --check && node --test \"test/*.test.mjs\"",
    "local": "node local/server.mjs",
    "demo": "node test/demo.mjs",
    "e2e": "python3 test/e2e.py",
    "live": "node tools/live-check.mjs",
    "sprites": "python3 tools/makepierre_mma.py",
    "deploy:worker": "cd worker && npx wrangler@4 deploy"
  }
}
